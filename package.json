{
  "name": "hexstake",
  "version": "0.1.0",
  "private": true,
  "description": "Simultaneous-turn hex strategy duels with Serble coin stakes",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node scripts/build.mjs",
