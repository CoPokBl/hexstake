    "test": "node scripts/build.mjs --tests && node --test dist-test/*.mjs"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
